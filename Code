<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Nebula AI — Supabase Auth</title>

<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", Arial, sans-serif;
  background: #000;
  color: #fff;
  overflow-x: hidden;
  scroll-behavior: smooth;
}
section { padding: 120px 20px; }
h1, h2, h3, p { margin: 0; }

/* Background */
.stars {
  position: fixed;
  top: 0; left: 0;
  width: 200%; height: 200%;
  background: url('https://i.imgur.com/9aK0R0v.png');
  animation: drift 120s linear infinite;
  opacity: 0.25;
  z-index: -2;
}
@keyframes drift {
  from { transform: translateY(0); }
  to { transform: translateY(-2000px); }
}
.nebula {
  position: fixed;
  width: 1500px; height: 1500px;
  background: radial-gradient(circle, rgba(120,0,255,0.4), transparent 70%);
  filter: blur(160px);
  top: -300px; left: -300px;
  z-index: -1;
}

/* Header */
header {
  position: fixed;
  top: 0; width: 100%;
  padding: 18px 24px;
  display: flex; justify-content: space-between; align-items: center;
  backdrop-filter: blur(20px);
  background: rgba(0,0,0,0.35);
  z-index: 1000;
}
header h1 {
  font-size: 20px;
  letter-spacing: 1.5px;
  font-weight: 600;
}
nav a {
  margin-left: 18px;
  font-size: 15px;
  opacity: 0.8;
  text-decoration: none;
  color: #fff;
  cursor: pointer;
}
nav a:hover { opacity: 1; }

/* Hero */
.hero {
  min-height: 100vh;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  text-align: center;
  padding-top: 90px;
}
.hero h2 {
  font-size: clamp(40px, 7vw, 72px);
  font-weight: 700;
  margin-bottom: 16px;
}
.hero p {
  font-size: 18px;
  max-width: 640px;
  opacity: 0.85;
  margin-bottom: 32px;
}
.hero .cta-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}
.btn-primary {
  padding: 14px 32px;
  background: linear-gradient(135deg, #6a00ff, #9d4bff);
  border-radius: 999px;
  border: none;
  color: #fff;
  font-size: 16px;
  cursor: pointer;
  transition: 0.2s;
}
.btn-primary:hover { transform: scale(1.05); }
.btn-ghost {
  padding: 14px 28px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.3);
  background: transparent;
  color: #fff;
  font-size: 16px;
  cursor: pointer;
  transition: 0.2s;
}
.btn-ghost:hover { background: rgba(255,255,255,0.08); }

/* Features */
#features {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
}
#features h2 {
  font-size: 32px;
  margin-bottom: 32px;
}
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px;
}
.feature-card {
  background: rgba(255,255,255,0.05);
  border-radius: 20px;
  padding: 24px;
  backdrop-filter: blur(18px);
  text-align: left;
  transition: 0.25s;
}
.feature-card:hover {
  transform: translateY(-6px);
  background: rgba(255,255,255,0.08);
}
.feature-card h3 {
  margin-bottom: 8px;
  font-size: 20px;
}
.feature-card p {
  font-size: 15px;
  opacity: 0.8;
}

/* Auth */
#auth {
  max-width: 420px;
  margin: 0 auto 80px auto;
}
#auth h2 {
  font-size: 28px;
  margin-bottom: 16px;
  text-align: center;
}
#auth p {
  font-size: 14px;
  opacity: 0.8;
  text-align: center;
  margin-bottom: 20px;
}
.auth-card {
  background: rgba(255,255,255,0.05);
  border-radius: 18px;
  padding: 20px;
  backdrop-filter: blur(18px);
}
.auth-card input {
  width: 100%;
  padding: 12px;
  margin: 8px 0;
  border-radius: 10px;
  border: none;
  background: #111;
  color: #fff;
}
.auth-card input::placeholder { color: #777; }
.auth-card button {
  width: 100%;
  padding: 12px;
  background: #6a00ff;
  border: none;
  border-radius: 999px;
  color: #fff;
  font-size: 15px;
  cursor: pointer;
  margin-top: 4px;
}
.auth-card button:hover { background: #8a33ff; }
.auth-sub {
  font-size: 13px;
  opacity: 0.7;
  margin-top: 10px;
  text-align: center;
}

/* Dashboard */
#dashboard {
  max-width: 600px;
  margin: 0 auto 80px auto;
  display: none;
}
.dashboard-card {
  background: rgba(255,255,255,0.05);
  border-radius: 18px;
  padding: 20px;
  backdrop-filter: blur(18px);
}
.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dashboard-header h3 {
  font-size: 20px;
}
.dashboard-body {
  margin-top: 16px;
  font-size: 14px;
  opacity: 0.85;
}
.logout-btn {
  padding: 8px 16px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.4);
  background: transparent;
  color: #fff;
  cursor: pointer;
  font-size: 13px;
}
.logout-btn:hover { background: rgba(255,255,255,0.08); }

/* Footer */
footer {
  padding: 40px 20px 30px;
  text-align: center;
  font-size: 13px;
  opacity: 0.6;
}

@media (min-width: 768px) {
  section { padding: 140px 60px; }
}
</style>
</head>

<body>
<div class="stars"></div>
<div class="nebula"></div>

<header>
  <h1>Nebula AI</h1>
  <nav>
    <a onclick="document.getElementById('hero').scrollIntoView()">Overview</a>
    <a onclick="document.getElementById('features').scrollIntoView()">Features</a>
    <a onclick="document.getElementById('auth').scrollIntoView()">Account</a>
  </nav>
</header>

<section id="hero" class="hero">
  <h2>Intelligence From Another Universe</h2>
  <p>Nebula AI blends cosmic‑scale reasoning with a calm, minimal interface—an assistant that feels effortless, precise, and beautifully human.</p>
  <div class="cta-row">
    <button class="btn-primary" onclick="document.getElementById('auth').scrollIntoView()">Get Started</button>
    <button class="btn-ghost" onclick="document.getElementById('features').scrollIntoView()">Learn More</button>
  </div>
</section>

<section id="features">
  <h2>Designed for the Infinite</h2>
  <div class="features-grid">
    <div class="feature-card">
      <h3>🌌 Deep‑Space Reasoning</h3>
      <p>Structured, multi‑step thinking that feels less like a search engine and more like a calm, focused mind.</p>
    </div>
    <div class="feature-card">
      <h3>⚡ Zero‑Gravity Flow</h3>
      <p>Fast responses, minimal friction—everything tuned so you stay in flow instead of fighting the interface.</p>
    </div>
    <div class="feature-card">
      <h3>🔒 Quietly Secure</h3>
      <p>Supabase‑backed authentication with real sessions and a proper database behind the scenes.</p>
    </div>
  </div>
</section>

<section id="auth">
  <h2>Your Nebula account</h2>
  <p>Sign up or log in with secure Supabase authentication.</p>

  <div class="auth-card" id="authCard">
    <!-- SIGNUP -->
    <div id="signupBox">
      <h3 style="font-size:18px;margin-bottom:8px;text-align:center;">Create account</h3>
      <input id="signupEmail" type="email" placeholder="Email">
      <input id="signupPassword" type="password" placeholder="Password">
      <button onclick="signup()">Sign Up</button>
      <div class="auth-sub">
        Already have an account?
        <span style="text-decoration:underline;cursor:pointer;" onclick="showLogin()">Log in</span>
      </div>
    </div>

    <!-- LOGIN -->
    <div id="loginBox" style="display:none;">
      <h3 style="font-size:18px;margin-bottom:8px;text-align:center;">Log in</h3>
      <input id="loginEmail" type="email" placeholder="Email">
      <input id="loginPassword" type="password" placeholder="Password">
      <button onclick="login()">Log In</button>
      <div class="auth-sub">
        Need an account?
        <span style="text-decoration:underline;cursor:pointer;" onclick="showSignup()">Sign up</span>
      </div>
    </div>
  </div>
</section>

<section id="dashboard">
  <div class="dashboard-card">
    <div class="dashboard-header">
      <h3 id="dashTitle">Nebula Console</h3>
      <button class="logout-btn" onclick="logout()">Log out</button>
    </div>
    <div class="dashboard-body">
      <p id="dashEmail"></p>
      <p style="margin-top:10px;">
        This is your logged‑in state. From here you could add:
      </p>
      <ul style="margin-top:6px; padding-left:18px;">
        <li>Chat UI</li>
        <li>Saved prompts</li>
        <li>Profile & settings</li>
        <li>Usage history</li>
      </ul>
    </div>
  </div>
</section>

<footer>
  © 2026 Nebula AI — Crafted for the quiet, infinite future.
</footer>

<!-- Correct Supabase CDN -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>
/* Correct initialization */
const SUPABASE_URL = "https://mmvxgcsgjjblaoyzwlge.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1tdnhnY3NnampibGFveXp3bGdlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE3MTQzMTgsImV4cCI6MjA4NzI5MDMxOH0.BvIEIJ4M_AZI5-mbx6k7xFH9DFtSbnwFRzaAx-6IVNE";

const supa = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

/* UI helpers */
function showLogin() {
  document.getElementById("signupBox").style.display = "none";
  document.getElementById("loginBox").style.display = "block";
}
function showSignup() {
  document.getElementById("loginBox").style.display = "none";
  document.getElementById("signupBox").style.display = "block";
}
function showDashboard(email) {
  document.getElementById("auth").style.display = "none";
  document.getElementById("dashboard").style.display = "block";
  document.getElementById("dashEmail").textContent = "Signed in as " + email;
}
function showAuth() {
  document.getElementById("auth").style.display = "block";
  document.getElementById("dashboard").style.display = "none";
}

/* Auth actions */
async function signup() {
  const email = document.getElementById("signupEmail").value.trim();
  const password = document.getElementById("signupPassword").value.trim();

  if (!email || !password) {
    alert("Enter email and password.");
    return;
  }

  const { error } = await supa.auth.signUp({ email, password });

  if (error) {
    alert("Sign up error: " + error.message);
    return;
  }

  alert("Sign up successful. Check your email for confirmation.");
}

async function login() {
  const email = document.getElementById("loginEmail").value.trim();
  const password = document.getElementById("loginPassword").value.trim();

  if (!email || !password) {
    alert("Enter email and password.");
    return;
  }

  const { data, error } = await supa.auth.signInWithPassword({ email, password });

  if (error) {
    alert("Login error: " + error.message);
    return;
  }

  showDashboard(email);
}

async function logout() {
  await supa.auth.signOut();
  showAuth();
}

/* On load: check session */
(async () => {
  const { data } = await supa.auth.getSession();
  if (data.session && data.session.user) {
    showDashboard(data.session.user.email);
  } else {
    showAuth();
  }
})();
</script>

</body>
</html>
